# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
build
*.local

# Xcode build artifacts
ios/App/App.xcarchive/
ios/App/*.xcarchive/

# macOS Finder/Capacitor-created duplicate config files (e.g. "config 2.xml")
ios/App/App/config [0-9]*.xml
android/app/src/main/res/xml/config [0-9]*.xml

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
.env
.env.local
.env.*.local
# iOS Firebase config (contains API keys)
ios/App/App/GoogleService-Info.plist
ios/App/DaySeven Watch Watch App/GoogleService-Info.plist

# Local dev/build config
.claude/launch.json
.claude/worktrees/
ios/debug.xcconfig
ios/App/archive.plist

# Scratch media dropped in during development. Demo assets the app references
# by path are NOT here — they live in public/demo-feed, public/demo-avatars and
# public/demo-progress, and are tracked: committed code hardcodes those paths,
# so a clone without them can't render the demo account correctly.
public/feed-photos/

# Rendered App Store frames — regenerate with `node app-store-screenshots/build.mjs`
# from the captures + config, which are tracked. ~27MB of derived PNGs otherwise.
app-store-screenshots/out/

# Orphaned Xcode duplicate (not referenced by project.pbxproj)
ios/App/Dayseven Watch Widgets 2/
