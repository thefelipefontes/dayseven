{
  "name": "dayseven-firestore-tests",
  "private": true,
  "description": "Emulator tests for firestore.rules (transitional) and firestore.strict.rules",
  "scripts": {
    "pretest": "node -e \"const f='../functions/.secret.local';require('fs').existsSync(f)||require('fs').writeFileSync(f,'REVENUECAT_WEBHOOK_SECRET=emulator-test-secret\\n')\"",
    "test": "firebase emulators:exec --project demo-dayseven --only auth,firestore,functions \"node --test --test-concurrency=1 *.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0"
  }
}
